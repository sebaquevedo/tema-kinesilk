{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customGradient": true,
			"palette": [
				{ "slug": "base", "color": "#FCF9EA", "name": "Crema" },
				{ "slug": "white", "color": "#FFFFFF", "name": "Blanco" },
				{ "slug": "contrast", "color": "#243330", "name": "Texto" },
				{ "slug": "contrast-soft", "color": "#51635E", "name": "Texto suave" },
				{ "slug": "primary", "color": "#87E9CE", "name": "Menta" },
				{ "slug": "primary-strong", "color": "#0B7E67", "name": "Menta intensa" },
				{ "slug": "secondary", "color": "#FEA4A4", "name": "Coral" },
				{ "slug": "secondary-strong", "color": "#C64A5E", "name": "Coral intenso" },
				{ "slug": "tertiary", "color": "#FFBDBE", "name": "Rosa" },
				{ "slug": "soft", "color": "#BADEDA", "name": "Agua" },
				{ "slug": "line", "color": "#E7E2CF", "name": "Línea" }
			],
			"gradients": [
				{
					"slug": "hero-fade",
					"name": "Degradado hero",
					"gradient": "linear-gradient(180deg, rgba(252,249,234,0) 0%, rgba(252,249,234,0.65) 72%, rgba(252,249,234,1) 100%)"
				},
				{
					"slug": "mint-soft",
					"name": "Menta suave",
					"gradient": "linear-gradient(135deg, #BADEDA 0%, #87E9CE 100%)"
				},
				{
					"slug": "cream-mint",
					"name": "Crema a menta",
					"gradient": "linear-gradient(180deg, #FCF9EA 0%, #EAF7F2 100%)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Segoe UI\", ui-sans-serif, -apple-system, BlinkMacSystemFont, Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeño", "size": "0.9375rem", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Grande", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Título", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Sección", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "huge", "name": "Hero", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"customSpacingSize": true,
			"spacingSizes": [
				{ "slug": "20", "name": "1 · XS", "size": "0.5rem" },
				{ "slug": "30", "name": "2 · S", "size": "1rem" },
				{ "slug": "40", "name": "3 · M", "size": "1.75rem" },
				{ "slug": "50", "name": "4 · L", "size": "2.75rem" },
				{ "slug": "60", "name": "5 · XL", "size": "4rem" },
				{ "slug": "70", "name": "6 · 2XL", "size": "6rem" },
				{ "slug": "80", "name": "7 · 3XL", "size": "8rem" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Suave", "shadow": "0 10px 30px -12px rgba(36,51,48,0.18)" },
				{ "slug": "card", "name": "Tarjeta", "shadow": "0 18px 40px -20px rgba(36,51,48,0.25)" },
				{ "slug": "float", "name": "Flotante", "shadow": "0 22px 55px -18px rgba(11,126,103,0.28)" }
			]
		},
		"dimensions": { "minHeight": true },
		"background": { "backgroundImage": true, "backgroundSize": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"letterSpacing": "0.1px"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "top": "0", "right": "var(--wp--preset--spacing--30)", "bottom": "0", "left": "var(--wp--preset--spacing--30)" }
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.12",
					"letterSpacing": "-0.5px"
				},
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-strong)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "underline" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--primary-strong)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.9rem", "right": "1.8rem", "bottom": "0.9rem", "left": "1.8rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600", "letterSpacing": "0.2px" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--contrast)" } }
			}
		},
		"blocks": {
			"core/heading": { "spacing": { "margin": { "bottom": "0.4em" } } },
			"core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } },
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"core/navigation": { "typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--medium)" } },
			"core/quote": { "typography": { "fontStyle": "normal" }, "border": { "left": { "color": "var(--wp--preset--color--primary)", "width": "4px" } } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing Kinesilk", "postTypes": ["page"] },
		{ "name": "page-no-title", "title": "Página sin título", "postTypes": ["page"] }
	]
}
